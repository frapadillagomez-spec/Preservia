{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.preserviacases.ime75s",
      "infoPlist": {
        "NSCameraUsageDescription": "Escanea documentos del caso con la cámara",
        "NSPhotoLibraryUsageDescription": "Adjunta documentos del caso desde tu galería",
        "NSFaceIDUsageDescription": "Desbloquea Preservia con Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.preserviacases.ime75s",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/preservia-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Desbloquea Preservia con Face ID"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
